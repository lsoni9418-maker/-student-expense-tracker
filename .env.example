# Copy this file to ".env" and fill in your own values. NEVER share or upload ".env".
FLASK_ENV=development
# Any long random text. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Supabase -> Project Settings -> Database -> Connection string (URI). Replace [YOUR-PASSWORD].
# If your password has special characters (@ # / : ?), URL-encode them.
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
